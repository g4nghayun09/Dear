# 이 파일을 복사해서 .env 로 만들고 값을 채우세요. (.env 는 GitHub에 올리지 않습니다)
# 폰에서 테스트할 때는 localhost 가 아니라 Spring 서버를 켠 노트북의 IP를 적어야 합니다.
# Windows: 명령 프롬프트에서 ipconfig → "IPv4 주소"
EXPO_PUBLIC_API_URL=http://192.168.0.12:8080

# [개발용] 로그인 기능 완성 전, 이 번호의 사용자로 테스트 (서버 .env 의 DEV_AUTH=true 필요)
# 폰 2대로 매칭을 시험할 때는 매칭 대기 화면 아래의 '테스트 사용자' 칸에서 폰마다 번호를 바꾸세요.
# 이 기능은 개발 모드(Expo Go)에서만 동작하고, APK에서는 자동으로 꺼집니다.
EXPO_PUBLIC_DEV_USER_ID=
