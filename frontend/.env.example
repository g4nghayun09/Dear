# Spring 서버 주소 (끝에 / 없이)
#  - 비워 두면 mock 모드: 서버 없이 가짜 데이터로 실행
#  - 휴대폰(Expo Go)에서 테스트할 때는 localhost 가 아니라 PC의 IP 주소를 써야 함
EXPO_PUBLIC_API_URL=
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8080

# 서버 주소를 넣은 상태에서도 mock 으로 돌리고 싶으면 true
EXPO_PUBLIC_USE_MOCK=false
# 구글 클라이언트 ID (Google Cloud Console). 서버의 GOOGLE_CLIENT_ID 에도 같은 값을 모두 넣을 것
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# (개발용) 구글 없이 이 이메일로 로그인. 서버를 dev 프로필로 실행해야 함
# EXPO_PUBLIC_DEV_LOGIN_EMAIL=minji@gmail.com
