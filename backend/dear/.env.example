# 이 파일을 복사해서 같은 폴더에 .env 로 저장하고 값을 채우세요 (.env 는 git에 올리지 않음)
DB_URL=jdbc:mysql://localhost:3306/dear?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=
DB_PASSWORD=

# [개발용] true 면 X-User-Id 헤더로 로그인 없이 테스트 + 기능 시연 API(/api/dev/**) 켜짐. 시연·배포 때는 false
DEV_AUTH=true
